{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true,
      "feature/music-library-browser-20260906": true,
      "fix/music-in-app-playback-title-stability-20260906": true
    }
  },
  "ignoreCommand": "test \"$VERCEL_PROJECT_PRODUCTION_URL\" != \"hos-t7r8.vercel.app\"",
  "rewrites": [
    {
      "source": "/woodland-walk",
      "destination": "/"
    },
    {
      "source": "/backing-tracks",
      "destination": "/"
    },
    {
      "source": "/orchestration-lab",
      "destination": "/"
    },
    {
      "source": "/music-discovery",
      "destination": "/"
    },
    {
      "source": "/water-garden",
      "destination": "/"
    },
    {
      "source": "/thekonym-viewer",
      "destination": "/"
    },
    {
      "source": "/concept-interactions",
      "destination": "/"
    },
    {
      "source": "/thekonym",
      "destination": "/"
    },
    {
      "source": "/world-3d",
      "destination": "/"
    },
    {
      "source": "/roy",
      "destination": "/"
    },
    {
      "source": "/book-vocab",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
